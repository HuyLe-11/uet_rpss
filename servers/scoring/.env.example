# Loaded by data config when running from the project root.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Public API URL is configured in the Vercel project, not used by this process.
OTT_SCORING_PORT=8110
OTT_SCORING_CORS_ORIGINS=https://ott.example.com
OTT_SCORING_BOT_DIR=./data/storage/submissions
OTT_SCORING_WORKERS=2
OTT_SCORING_QUEUE_SIZE=100
OTT_SCORING_MATCH_TIMEOUT_SECONDS=15
OTT_SCORING_JOB_TIMEOUT_SECONDS=60
OTT_SCORING_QUEUE_POLL_SECONDS=0.5

# Judge0 stays private on the laptop. The module submits whole matches to it.
OTT_JUDGE0_URL=http://127.0.0.1:2358
OTT_JUDGE0_PYTHON_ID=71
OTT_JUDGE0_CPU_SECONDS=10
OTT_JUDGE0_MAX_SECONDS=15
OTT_JUDGE0_MEMORY_KB=262144
# Set both only if Judge0 AUTHN_HEADER/AUTHN_TOKEN are enabled in judge0.conf.
OTT_JUDGE0_AUTH_HEADER=
OTT_JUDGE0_AUTH_TOKEN=

# Optional Cloudflare scoring engine. When set, all BO2 executions use it.
OTT_SCORING_PROXY_URL=https://your-worker.workers.dev
OTT_SCORING_PROXY_TOKEN=server-only-proxy-token

# Vercel environment:
# VITE_SCORING_MODULE_URL=https://score.example.com
